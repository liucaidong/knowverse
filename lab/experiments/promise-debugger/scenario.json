{
  "id": "thenable-inner-adoption",
  "title": "thenable → inner Promise → 微任务队列",
  "level": "进阶",
  "objective": "逐步追踪同步 getter、thenable job、inner 采用、Promise reaction 与 queueMicrotask 的入队次序。",
  "code": [
    "let finish;",
    "const inner = new Promise(resolve => {",
    "  finish = resolve;",
    "});",
    "",
    "const thenable = {",
    "  get then() {",
    "    console.log(\"get\");",
    "    return (resolve, reject) => {",
    "      console.log(\"call\");",
    "      resolve(inner);",
    "      reject(new Error(\"late\"));",
    "      throw new Error(\"thenable-throw\");",
    "    };",
    "  }",
    "};",
    "",
    "console.log(\"start\");",
    "const outer = Promise.resolve(thenable);",
    "outer.then(value => console.log(\"value\", value));",
    "",
    "queueMicrotask(() => {",
    "  console.log(\"M1\");",
    "  finish(42);",
    "  queueMicrotask(() => console.log(\"M2\"));",
    "});",
    "",
    "console.log(\"end\");"
  ],
  "expectedOutput": [
    "start",
    "get",
    "end",
    "call",
    "M1",
    "M2",
    "value 42"
  ],
