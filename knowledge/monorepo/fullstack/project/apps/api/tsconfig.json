{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ]
  },
  "references": [
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/domain"
    }
  ],
  "include": [
    "src/**/*.ts"
  ]
}
