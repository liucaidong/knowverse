  "gaps": [
    {
      "id": "thenable-get-vs-call",
      "label": "then 属性读取与函数调用混淆",
      "description": "Get(thenable, 'then') 是同步属性读取；调用取到的 then 函数发生在后续 ThenableJob。",
      "competencyIds": [
        "thenable-adoption"
      ]
    },
    {
      "id": "resolved-vs-settled",
      "label": "resolved 与 settled 混淆",
      "description": "resolve(inner) 会锁定解决权，但 outer 仍可能处于 pending，并继续采用 inner。",
      "competencyIds": [
        "thenable-adoption"
      ]
    },
    {
      "id": "thenable-job-timing",
      "label": "ThenableJob 的执行边界混淆",
      "description": "同步读取 then 不等于同步调用 then；函数调用由后续 Job 执行。",
      "competencyIds": [
        "thenable-adoption",
        "integrated-execution-model"
      ]
    },
    {
      "id": "reaction-registration-timing",
      "label": "reaction 注册与执行时机混淆",
      "description": "then 负责注册 reaction；回调并不会因此同步执行。",
      "competencyIds": [
        "microtask-scheduling"
      ]
    },
    {
      "id": "microtask-fifo",
      "label": "微任务 FIFO 入队顺序混淆",
      "description": "按实际入队顺序推导，而不是按代码块位置或结果名称猜测。",
      "competencyIds": [
        "microtask-scheduling"
      ]
    },
    {
      "id": "nested-microtask",
      "label": "嵌套微任务入队时机混淆",
      "description": "嵌套任务在当前回调执行时才入队，已经排队的任务会先运行。",
      "competencyIds": [
        "microtask-scheduling"
      ]
    },
    {
      "id": "then-rejection-boundary",
      "label": "then 的拒绝处理边界混淆",
      "description": "同一次 then 的 onRejected 处理的是源 Promise 的拒绝，不会捕获同次 onFulfilled 抛出的异常。",
      "competencyIds": [
        "chain-error-propagation"
      ]
    },
    {
      "id": "chain-state-recovery",
      "label": "Promise 状态与链式恢复混淆",
      "description": "单个 Promise 状态不可逆，但 catch 会创建新的下游 Promise。",
      "competencyIds": [
        "chain-error-propagation"
      ]
    },
    {
      "id": "then-new-promise",
      "label": "then 返回新 Promise 的对象关系不清",
      "description": "每次 then 都返回新 Promise，下游状态取决于处理器结果。",
      "competencyIds": [
        "chain-error-propagation"
      ]
    },
    {
      "id": "all-race-order",
      "label": "all 输入顺序与 race 首个落定混淆",
      "description": "all 结果按输入索引排列；race 观察最先落定的输入。",
      "competencyIds": [
        "combinator-semantics"
      ]
    },
    {
      "id": "all-waits-all",
      "label": "Promise.all 的全部成功条件混淆",
      "description": "Promise.all 需要全部输入兑现后才兑现。",
      "competencyIds": [
        "combinator-semantics"
      ]
    },
    {
      "id": "all-no-cancel",
      "label": "组合结果与底层取消混淆",
      "description": "组合 Promise 快速拒绝不代表底层任务会自动取消。",
      "competencyIds": [
        "combinator-semantics"
      ]
    },
    {
      "id": "getter-sync",
      "label": "then getter 的同步时机混淆",
      "description": "then getter 在 Promise 解析流程中同步读取，不能放到 ThenableJob 之后。",
      "competencyIds": [
        "integrated-execution-model"
      ]
    },
    {
      "id": "adoption-timeline",
      "label": "resolved-but-pending 采用时序混淆",
      "description": "解决权锁定、inner 状态落定、outer 兑现和 reaction 输出是不同阶段。",
      "competencyIds": [
        "integrated-execution-model"
      ]
    },
    {
      "id": "workspace-protocol",
      "label": "workspace 协议与普通 semver 混淆",
      "description": "workspace:* 明确要求消费者使用当前仓库中的工作区包。",
      "competencyIds": [
        "workspace-resolution"
      ]
    },
    {
      "id": "build-dependency-order",
      "label": "构建顺序与依赖约束混淆",
      "description": "必须先构建依赖提供者，再构建消费者；无依赖边的任务可以并行。",
      "competencyIds": [
        "build-topology"
      ]
    },
    {
      "id": "affected-reverse-closure",
      "label": "Affected 传播方向或闭包不完整",
      "description": "变更影响沿依赖边反方向传播，并递归覆盖所有消费者。",
      "competencyIds": [
        "affected-closure"
      ]
    }
  ]
